FROM node:22-alpine

RUN apk add --no-cache poppler-utils tesseract-ocr-data-eng

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY lib/ ./lib/
COPY scripts/run-document-ocr-worker.mjs scripts/purge-document-ocr.mjs ./scripts/

USER node
CMD ["node", "scripts/run-document-ocr-worker.mjs"]
