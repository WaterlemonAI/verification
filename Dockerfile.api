FROM node:22-alpine

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server.mjs ./
COPY lib/ ./lib/
COPY top_50_media_publishers_30_largest_economies_2026.json ./
COPY scripts/ ./scripts/
COPY site/ ./site/
COPY api-site/ ./api-site/
COPY admin-site/ ./admin-site/
COPY api/openapi.json ./api/openapi.json
COPY bank-statement-analysis/openapi.local.json ./bank-statement-analysis/openapi.local.json

RUN mkdir /data && chown node:node /data

USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:8080/healthz || exit 1

CMD ["node", "server.mjs"]
