FROM node:22-bookworm-slim

WORKDIR /app
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

COPY package.json package-lock.json ./
RUN npm ci --omit=dev \
    && npx playwright-core install --with-deps chromium \
    && chown -R node:node /ms-playwright /app

COPY merchant-screenshot-worker.mjs ./
COPY lib/merchant-screening.mjs lib/merchant-screening-network.mjs lib/merchant-screenshot.mjs ./lib/

USER node
ENV NODE_ENV=production
ENV MERCHANT_SCREENSHOT_ISOLATED_WORKER=true
ENV PORT=8081

EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=3s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:8081/healthz').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"

CMD ["node", "merchant-screenshot-worker.mjs"]
